rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPER FUNCTIONS (Kiểm tra xác thực & vai trò từ Firestore)
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userExists() ? getUserData().role : 'guest';
    }

    function getUserClassId() {
      return userExists() && ('classId' in getUserData()) ? getUserData().classId : '';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && getUserRole() in ['sensei', 'admin'];
    }

    function isStudentOrAbove() {
      return isSignedIn() && getUserRole() in ['student', 'sensei', 'admin'];
    }

    // Kiểm tra quyền đọc tài nguyên gắn với lớp học (class-level isolation)
    function canReadClassResource(resourceClassId) {
      return isTeacherOrAdmin()
        || (isStudentOrAbove() && (resourceClassId == 'ALL' || resourceClassId == getUserClassId()));
    }

    // ===============================================================
    // 1. USERS & PROFILES (`users`)
    // ===============================================================
    match /users/{userId} {
      // - Sensei/Admin đọc được tất cả hồ sơ
      // - Chủ tài khoản luôn đọc được hồ sơ của chính mình
      // - Học viên chỉ đọc được thành viên cùng lớp (classId khớp)
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isTeacherOrAdmin()
        || (isStudentOrAbove() && ('classId' in resource.data) && resource.data.classId == getUserClassId())
      );

      // Tự đăng ký mới: BẮT BUỘC chỉ được tạo cho chính UID của mình,
      // mặc định role = 'guest' và KHÔNG được tự gán classId
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'guest'
        && !('classId' in request.resource.data);

      // Cập nhật:
      // - Admin được toàn quyền (xếp lớp, đổi role, bổ nhiệm Sensei)
      // - Chủ tài khoản chỉ được sửa thông tin cá nhân, TUYỆT ĐỐI KHÔNG được tự sửa role/classId/code
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'classId', 'className', 'code', 'uid', 'email'])
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. CLASSES (`classes`)
    // ===============================================================
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();

      // Admin sửa toàn bộ; Sensei chỉ được cập nhật tiến độ buổi học / bài đang học
      allow update: if isAdmin() || (
        isTeacherOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completedSessions', 'currentLesson', 'currentLessonJa'])
      );
    }

    // ===============================================================
    // 3. JLPT TESTS (`tests`) & ANSWER KEYS (`test_answer_keys`)
    // ===============================================================
    match /tests/{testId} {
      // Học viên chỉ đọc được đề thi của lớp mình hoặc đề chung ("ALL")
      allow read: if canReadClassResource(resource.data.classId);
      allow create, update, delete: if isTeacherOrAdmin();
    }

    match /test_answer_keys/{testId} {
      // TUYỆT ĐỐI khóa học viên đọc đáp án từ trình duyệt.
      // Chỉ Sensei/Admin và Server (Firebase Admin SDK) mới có quyền truy cập.
      allow read, write: if isTeacherOrAdmin();
    }

    // ===============================================================
    // 4. TEST SUBMISSIONS (`test_submissions`)
    // ===============================================================
    match /test_submissions/{subId} {
      // Sensei/Admin xem tất cả; Học viên CHỈ đọc được kết quả thi của chính mình
      allow read: if isTeacherOrAdmin()
        || (isStudentOrAbove() && resource.data.studentId == request.auth.uid);

      // LƯU Ý PRODUCTION: Sau khi đã cấu hình FIREBASE_SERVICE_ACCOUNT_KEY trên Vercel
      // để chấm điểm 100% qua `/api/tests/[id]/submit`, hãy đổi dòng dưới thành:
      // allow create: if false;
      allow create: if isStudentOrAbove()
        && request.resource.data.studentId == request.auth.uid;

      // Chặn học viên tự ý sửa điểm hoặc xóa bài sau khi đã nộp
      allow update, delete: if isTeacherOrAdmin();
    }

    // ===============================================================
    // 5. ASSIGNMENTS (`assignments`) & SUBMISSIONS SUBCOLLECTION
    // ===============================================================
    match /assignments/{asgId} {
      // Học viên chỉ đọc được bài tập của lớp mình hoặc bài chung ("ALL")
      allow read: if canReadClassResource(resource.data.classId);
      allow create, delete: if isTeacherOrAdmin();

      // Legacy map update (giữ tương thích ngược cho dữ liệu cũ)
      allow update: if isTeacherOrAdmin() || (
        isStudentOrAbove()
        && canReadClassResource(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissions'])
        && (
          !('submissions' in resource.data)
            ? request.resource.data.submissions.keys().hasOnly([request.auth.uid])
            : request.resource.data.submissions.diff(resource.data.submissions).affectedKeys().hasOnly([request.auth.uid])
        )
        && request.resource.data.submissions[request.auth.uid].status == 'submitted'
      );

      // Subcollection chuẩn scale: `assignments/{asgId}/submissions/{studentId}`
      match /submissions/{studentId} {
        allow read: if isTeacherOrAdmin()
          || (isStudentOrAbove() && request.auth.uid == studentId);

        // Học viên chỉ được nộp/sửa bài của chính mình ở trạng thái 'submitted',
        // tuyệt đối không được tự ghi score / feedback / gradedAt
        allow create, update: if isTeacherOrAdmin() || (
          isStudentOrAbove()
          && request.auth.uid == studentId
          && request.resource.data.status == 'submitted'
          && !request.resource.data.keys().hasAny(['score', 'feedback', 'gradedAt'])
        );

        allow delete: if isTeacherOrAdmin();
      }
    }

    // ===============================================================
    // 6. ANNOUNCEMENTS (`announcements`)
    // ===============================================================
    match /announcements/{annId} {
      // Tài khoản Khách không được đọc; Học viên chỉ đọc thông báo lớp mình hoặc "ALL"
      allow read: if canReadClassResource(resource.data.classId);
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // ===============================================================
    // 7. STUDY MATERIALS (`materials`)
    // ===============================================================
    match /materials/{matId} {
      // Học viên chỉ đọc tài liệu của lớp mình hoặc "ALL"
      allow read: if canReadClassResource(resource.data.classId);
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // ===============================================================
    // 8. CONSULTATION LEADS (`leads`)
    // ===============================================================
    match /leads/{leadId} {
      // Khách vãng lai trên Landing Page được phép gửi form tư vấn
      allow create: if request.resource.data.keys().hasAll(['fullName', 'phone'])
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30;

      // Chỉ Admin mới có quyền đọc danh sách khách hàng và cập nhật trạng thái tư vấn
      allow read, update, delete: if isAdmin();
    }
  }
}
